# OpenRouter AI Configuration (Get your free key at https://openrouter.ai/)
VITE_OPENROUTER_API_KEY=

# Gemini AI Configuration (Get your free key at https://aistudio.google.com/)
VITE_GEMINI_API_KEY=

# Market Data Providers for Real-Time NSE and BSE Prices
# Provider options: 'free-direct' (default, zero-setup), 'alpha-vantage', 'rapid-api', 'broker'
VITE_MARKET_DATA_PROVIDER=free-direct

# Optional Official API Keys (Enter if you have paid or developer subscriptions)
VITE_ALPHA_VANTAGE_KEY=
VITE_NSE_API_KEY=
VITE_BSE_API_KEY=
VITE_BROKER_API_KEY=
